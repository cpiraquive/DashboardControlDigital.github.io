// 4.2.5 Módulo de Reportes de Valor y Avance (NUEVA VISTA)
const ValueReports = ({ projects, productBacklog }) => {
    
    // 1. Calcular el Valor Entregado por PBI
    const deliveredValuePbis = productBacklog.filter(pbi => pbi.status === 'Terminada' && pbi.businessValue > 0);

    // 2. Agrupar el valor entregado por Proyecto
    const valueByProject = useMemo(() => {
        const valueMap = {};
        const effortMap = {};
        let totalDeliveredValue = 0;
        let totalPotentialValue = 0;

        // Inicializar mapas y calcular valores totales
        projects.forEach(p => {
            valueMap[p.id] = { name: p.name, deliveredValue: 0, potentialValue: 0, deliveredEffort: 0, totalEffort: 0 };
        });

        // Sumar valor entregado y potencial
        productBacklog.forEach(pbi => {
            if (valueMap[pbi.projectId]) {
                const isDelivered = pbi.status === 'Terminada';
                
                // Valor Potencial (todos los PBIs del proyecto)
                valueMap[pbi.projectId].potentialValue += pbi.businessValue;
                totalPotentialValue += pbi.businessValue;

                // Valor Entregado (PBIs terminados)
                if (isDelivered) {
                    valueMap[pbi.projectId].deliveredValue += pbi.businessValue;
                    totalDeliveredValue += pbi.businessValue;
                    valueMap[pbi.projectId].deliveredEffort += pbi.effortPoints;
                }
                
                valueMap[pbi.projectId].totalEffort += pbi.effortPoints;
            }
        });
        
        const projectReports = Object.values(valueMap).map(report => ({
            ...report,
            completionRate: report.totalEffort > 0 ? ((report.deliveredEffort / report.totalEffort) * 100).toFixed(1) : 0,
            valueDeliveryRate: report.potentialValue > 0 ? ((report.deliveredValue / report.potentialValue) * 100).toFixed(1) : 0,
        })).sort((a, b) => b.deliveredValue - a.deliveredValue); // Ordenar por valor entregado

        return {
            totalDeliveredValue,
            totalPotentialValue,
            projectReports
        };
    }, [projects, productBacklog]);
    
    const { totalDeliveredValue, totalPotentialValue, projectReports } = valueByProject;
    
