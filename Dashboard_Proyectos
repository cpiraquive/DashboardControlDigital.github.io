                {/* Resto de las Columnas */}
                <td className="px-6 py-4 text-sm font-medium text-gray-900">
                    <span className="text-xs text-gray-500 block">#{pbi.id}</span>
                    <span title={pbi.description}>{pbi.title}</span>
                </td>
                <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <TypeBadge type={pbi.pbiType} />
                </td>
                <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{projectMap[pbi.projectId]}</td>
                <td className="px-6 py-4 whitespace-nowrap"><PriorityBadge priority={pbi.priority} /></td>
                <td className="px-3 py-4 whitespace-nowrap text-center text-sm font-semibold text-green-600">{pbi.businessValue}</td>
                <td className="px-3 py-4 whitespace-nowrap text-center text-sm font-semibold text-indigo-600">{pbi.effortPoints}</td>
                <td className="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-700">{calculateRatio(pbi.businessValue, pbi.effortPoints)}</td>
                <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{pbi.assignedTo || 'N/A'}</td>
                <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-700">{pbi.status}</td>
                {canManageBacklog && (
                  <td className="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <button
                      onClick={() => onEditPbi(pbi)}
                      className="text-indigo-600 hover:text-indigo-900 mr-3"
                      title="Editar"
                    >
                      <Edit className="w-4 h-4" />
                    </button>
                    <button
                      onClick={() => onDeletePbi(pbi.id)}
                      className="text-red-600 hover:text-red-900"
                      title="Eliminar"
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
        {filteredAndRankedBacklog.length === 0 && (
          <div className="text-center py-10 text-gray-500">No se encontraron ítems de Backlog.</div>
        )}
      </div>
      
      {canManageBacklog && (
          <div className="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-700">
              <span className="font-semibold">Nota para el PO/Gerente:</span> El **Rank** se basa en el índice Valor de Negocio / Story Points, lo que refleja el principio de **"mayor valor por menor esfuerzo"**. Utilice los botones de flecha para gestionar el orden de forma interactiva.
          </div>
      )}
    </div>
  );
};


