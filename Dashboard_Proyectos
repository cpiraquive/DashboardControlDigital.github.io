// Componente de Semáforo de Estado de Proyecto
const StatusSemaphore = ({ status }) => {
  const baseClasses = "w-3 h-3 rounded-full mr-2";
  let color = 'bg-gray-400';
  let label = status;

  switch (status) {
    case 'Completado':
      color = 'bg-green-500';
      break;
    case 'En Progreso':
      color = 'bg-yellow-500 animate-pulse';
      break;
    case 'Iniciado':
      color = 'bg-blue-500';
      break;
    case 'En Pausa':
      color = 'bg-orange-500';
      break;
    case 'Cancelado':
      color = 'bg-red-500';
      break;
    default:
      color = 'bg-gray-400';
      break;
  }

  return (
    <div className="flex items-center text-sm">
      <div className={`${baseClasses} ${color}`}></div>
      <span>{label}</span>
    </div>
  );
};

