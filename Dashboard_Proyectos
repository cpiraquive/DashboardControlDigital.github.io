// 4.1. Descripción del PMV - Componente Principal (ACTUALIZADO)
export default function App() {
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [currentUser, setCurrentUser] = useState(null);
  const [projects, setProjects] = useState(initialProjects);
  const [productBacklog, setProductBacklog] = useState(initialProductBacklog);
  const [currentView, setCurrentView] = useState('dashboard');
  
  // Estado para formularios modales de proyectos
  const [isProjectFormOpen, setIsProjectFormOpen] = useState(false);
  const [projectToEdit, setProjectToEdit] = useState(null);
  
  // Estado para formularios modales de PBIs
  const [isPbiFormOpen, setIsPbiFormOpen] = useState(false);
  const [pbiToEdit, setPbiToEdit] = useState(null);
  
  // Estado para la confirmación de eliminación (general)
  const [isConfirmModalOpen, setIsConfirmModalOpen] = useState(false);
  const [itemToDelete, setItemToDelete] = useState(null); // {id: 1, type: 'project'/'pbi'}

  // Funciones de Autenticación
  const handleLogin = (user) => {
    setCurrentUser(user);
    setIsAuthenticated(true);
  };

  const handleLogout = () => {
    setCurrentUser(null);
    setIsAuthenticated(false);
    setCurrentView('dashboard');
  };
  
  // Lógica de permisos
  const canCreateOrEdit = currentUser?.role === ROLES.ADMIN || currentUser?.role === ROLES.MANAGER;
  const canDelete = currentUser?.role === ROLES.ADMIN;
  const canManageBacklog = currentUser?.role === ROLES.ADMIN || currentUser?.role === ROLES.MANAGER;


  // --- CRUD Proyectos ---
  const handleSaveProject = (newProjectData) => {
    const parsedData = {
        ...newProjectData,
        budget: Number(newProjectData.budget),
        totalEffort: Number(newProjectData.totalEffort),
    };
      
    if (parsedData.id) {
      setProjects(prev => prev.map(p => p.id === parsedData.id ? { ...p, ...parsedData } : p));
    } else {
      setProjects(prev => [
        { ...parsedData, id: getNextId(), effortCompleted: 0, satisfaction: 0 },
        ...prev
      ]);
    }
    setIsProjectFormOpen(false);
    setProjectToEdit(null);
  };
  
  const handleEditProject = (project) => {
      if (canCreateOrEdit) {
          setProjectToEdit(project);
          setIsProjectFormOpen(true);
      } else {
          console.log("Permiso denegado para editar proyecto.");
      }
  };
  
  // --- CRUD Product Backlog Items (PBI) ---
  const handleSavePbi = (newPbiData) => {
    const isNew = !newPbiData.id;
    if (isNew) {
        // En un nuevo PBI, darle el rank siguiente al último elemento
        const maxRank = productBacklog.reduce((max, pbi) => Math.max(max, pbi.rank), 0);
        newPbiData.rank = maxRank + 1;
    }
      
    if (!isNew) {
      // Actualizar
      setProductBacklog(prev => prev.map(pbi => pbi.id === newPbiData.id ? { ...pbi, ...newPbiData } : pbi));
    } else {
      // Crear
      setProductBacklog(prev => [
        { ...newPbiData, id: getNextPbiId() },
        ...prev
      ]);
    }
    setIsPbiFormOpen(false);
    setPbiToEdit(null);
  };

  const handleEditPbi = (pbi) => {
      if (canManageBacklog) {
          setPbiToEdit(pbi);
          setIsPbiFormOpen(true);
      } else {
          console.log("Permiso denegado para editar PBI.");
      }
  };

  // Función de Reordenamiento del Backlog (Función clave del PO)
  const handleReorderPbi = useCallback((pbiId, direction) => {
    setProductBacklog(prevPbis => {
        // Clonar y ordenar la lista para garantizar que los ranks sean contiguos
        const sortedPbis = [...prevPbis].sort((a, b) => a.rank - b.rank);
        const currentIndex = sortedPbis.findIndex(p => p.id === pbiId);

        if (currentIndex === -1) return prevPbis;

        let newIndex = currentIndex;
        if (direction === 'up' && currentIndex > 0) {
            newIndex = currentIndex - 1;
        } else if (direction === 'down' && currentIndex < sortedPbis.length - 1) {
            newIndex = currentIndex + 1;
        } else {
            return prevPbis; // No hay cambio
        }

        // Intercambiar elementos en el array ordenado
        [sortedPbis[currentIndex], sortedPbis[newIndex]] = [sortedPbis[newIndex], sortedPbis[currentIndex]];

        // Reasignar los ranks basados en la nueva posición (1, 2, 3, ...)
        const newRankedPbis = sortedPbis.map((pbi, index) => ({
            ...pbi,
            rank: index + 1 // El índice + 1 es el nuevo rank
        }));

        return newRankedPbis;
    });
  }, []);
  
  // --- Funciones de Eliminación con Modal ---
  const handleDeleteItemClick = (id, type) => {
      if (!canDelete && type === 'project') {
          console.log("Permiso denegado para eliminar proyecto.");
          return;
      }
      if (!canManageBacklog && type === 'pbi') {
          console.log("Permiso denegado para eliminar PBI.");
          return;
      }
      
      setItemToDelete({ id, type });
      setIsConfirmModalOpen(true);
  };
  
  const confirmDelete = () => {
      if (!itemToDelete) return;
      
      const { id, type } = itemToDelete;

      if (type === 'project') {
          setProjects(prev => prev.filter(p => p.id !== id));
          // Opcional: eliminar PBIs asociados
          setProductBacklog(prev => prev.filter(pbi => pbi.projectId !== id));
      } else if (type === 'pbi') {
          setProductBacklog(prev => {
            const updatedPbis = prev.filter(pbi => pbi.id !== id);
            // Reajustar ranks de los elementos restantes
            return updatedPbis.sort((a, b) => a.rank - b.rank).map((pbi, index) => ({ ...pbi, rank: index + 1 }));
          });
      }

      setIsConfirmModalOpen(false);
      setItemToDelete(null);
  };
  
  const cancelDelete = () => {
      setIsConfirmModalOpen(false);
      setItemToDelete(null);
  };
  
  // Mensaje para el modal de confirmación
  const deleteModalMessage = itemToDelete 
      ? (itemToDelete.type === 'project' 
          ? `¿Está seguro de que desea eliminar el proyecto con ID ${itemToDelete.id}? Esta acción también eliminará sus PBIs asociados y es irreversible.`
          : `¿Está seguro de que desea eliminar el PBI con ID ${itemToDelete.id}? Esta acción es irreversible.`)
      : "";


  if (!isAuthenticated) {
    return <LoginScreen handleLogin={handleLogin} />;
  }

  return (
    <DashboardLayout
      user={currentUser}
      handleLogout={handleLogout}
      currentView={currentView}
      setCurrentView={setCurrentView}
      onCreateProjectClick={() => { setProjectToEdit(null); setIsProjectFormOpen(true); }}
      onCreatePbiClick={() => { setPbiToEdit(null); setIsPbiFormOpen(true); }} // Nuevo handler
      canCreateProject={canCreateOrEdit}
    >
      
      {/* Modales de Proyectos */}
      {isProjectFormOpen && (
        <ProjectForm
          projectToEdit={projectToEdit}
          onSave={handleSaveProject}
          onCancel={() => setIsProjectFormOpen(false)}
        />
      )}
      
      {/* Modales de PBIs */}
      {isPbiFormOpen && (
        <PbiForm
          pbiToEdit={pbiToEdit}
          projects={projects}
          onSave={handleSavePbi}
          onCancel={() => setIsPbiFormOpen(false)}
        />
      )}
      
      {/* Modal de Confirmación General */}
      <ConfirmationModal 
          title="Confirmar Eliminación"
          message={deleteModalMessage}
          isOpen={isConfirmModalOpen}
          onConfirm={confirmDelete}
          onCancel={cancelDelete}
      />

      {currentView === 'dashboard' && <DashboardExecutive projects={projects} productBacklog={productBacklog} />}
      
      {currentView === 'projects' && (
        <ProjectList 
          projects={projects} 
          role={currentUser.role} 
          onEditProject={handleEditProject}
          onDeleteProject={(id) => handleDeleteItemClick(id, 'project')} 
        />
      )}
      
      {currentView === 'backlog' && (
        <ProductBacklogManagement
          productBacklog={productBacklog}
          projects={projects}
          role={currentUser.role}
          onEditPbi={handleEditPbi}
          onDeletePbi={(id) => handleDeleteItemClick(id, 'pbi')}
          onCreatePbiClick={() => { setPbiToEdit(null); setIsPbiFormOpen(true); }}
          onReorderPbi={handleReorderPbi} // Nueva función de reordenamiento
        />
      )}
      
      {currentView === 'reports' && (
        <ValueReports 
          projects={projects} 
          productBacklog={productBacklog} 
        />
      )}
      
      {/* Mensaje de Permiso (Simulación para Miembro de Equipo) */}
      {(currentView === 'projects' || currentView === 'backlog' || currentView === 'reports') && currentUser.role === ROLES.MEMBER && (
          <div className="p-4 bg-yellow-100 text-yellow-800 border-l-4 border-yellow-500 mx-4 md:mx-8 rounded-lg mt-4">
              <p className="font-semibold">Vista de Miembro de Equipo:</p>
              <p className="text-sm">Solo tiene permisos de visualización. Las acciones de gestión (Creación/Edición/Eliminación) están deshabilitadas.</p>
          </div>
      )}
    </DashboardLayout>
  );
}
